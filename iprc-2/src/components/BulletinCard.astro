---
interface Props { title: string; date: string; summary: string; href: string; }
const { title, date, summary, href } = Astro.props;
---
<article class="bulletin-card reveal">
  <div class="bulletin-art" aria-hidden="true"><span>IPRC</span><strong>BOLETIM</strong><small>SEMANAL</small></div>
  <div class="bulletin-copy"><p class="eyebrow">Boletim atual</p><p class="meta">{date}</p><h3>{title}</h3><p>{summary}</p><a class="button button-light" href={href}>Abrir boletim <span aria-hidden="true">↗</span></a></div>
</article>
