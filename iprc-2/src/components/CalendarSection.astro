---
import AgendaEventCard from './AgendaEventCard.astro';
import NextMeeting from './NextMeeting.astro';
import { agendaRepository } from '../repositories/StaticAgendaRepository';
import '../styles/agenda.css';
const schedules = await agendaRepository.listActiveRecurring();
const specialEvents = (await agendaRepository.listUpcomingEvents()).slice(0, 2);
---
<section class="section calendar-section" id="agenda" aria-labelledby="calendar-title">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">Caminhe conosco</p><h2 id="calendar-title">Agenda da igreja</h2></div><p>A programação oficial da IPRC, reunida em um só lugar e confortável para consultar no celular.</p></div>
    <NextMeeting {schedules} compact headingLevel="h3" />
    {specialEvents.length > 0 && <div class="home-special-events" aria-label="Próximos eventos especiais">{specialEvents.map(event => <AgendaEventCard {event} />)}</div>}
    <p class="calendar-action"><a class="button button-primary" href="/agenda">Ver agenda completa <span aria-hidden="true">→</span></a></p>
  </div>
</section>
