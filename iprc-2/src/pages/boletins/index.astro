---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatBulletinDate } from '../../domain/bulletin';
import { bulletinRepository } from '../../repositories/StaticBulletinRepository';
import '../../styles/bulletins.css';
const bulletins = await bulletinRepository.listPublished();
---
<BaseLayout title="Boletins — IPRC" description="Pastorais, avisos e informações semanais da Igreja Presbiteriana do Rio Comprido." canonicalPath="/boletins">
  <section class="bulletins-hero"><div class="container"><p class="eyebrow">Vida em comunidade</p><h1>Boletins<br />da IPRC</h1><p>A versão digital da nossa publicação semanal, preparada para uma leitura confortável em qualquer tela.</p></div></section>
  <section class="bulletins-list section container" aria-labelledby="published-bulletins" data-bulletin-list hidden={bulletins.length === 0}><h2 id="published-bulletins">Boletins publicados</h2><div class="bulletin-list-grid" data-bulletin-grid>{bulletins.map(bulletin => <article class="bulletin-list-card"><p class="meta">Boletim nº {bulletin.number}</p><h3>{bulletin.pastoral.title}</h3><time datetime={bulletin.date}>{formatBulletinDate(bulletin.date)}</time><a href={`/boletins/${bulletin.slug}`}>Ler boletim <span aria-hidden="true">→</span></a></article>)}</div></section>
  <section class="bulletins-empty container" data-empty-bulletins hidden={bulletins.length > 0}><span aria-hidden="true">◇</span><p class="eyebrow">Acervo em preparação</p><h2>Os boletins serão publicados aqui em breve.</h2><p>Nenhum boletim fictício foi adicionado. Assim que houver uma edição real e autorizada, ela aparecerá nesta página.</p></section>
</BaseLayout>
<script>import '../../scripts/public-bulletins';</script>
