---
import BaseLayout from '../../layouts/BaseLayout.astro';import StudyTranscript from '../../components/StudyTranscript.astro';import BibleReferencePreview from '../../components/BibleReferencePreview.astro';import { bibleBooks,bibleReferenceLabel,formatStudyDate } from '../../domain/study';import '../../styles/studies.css';
export async function getStaticPaths(){const {studyRepository}=await import('../../repositories/StaticStudyRepository');return(await studyRepository.listPublished()).map(study=>({params:{slug:study.slug},props:{study}}))}
const {study}=Astro.props;
---
<BaseLayout title={`${study.title} — Estudos IPRC`} description={study.summary} canonicalPath={`/estudos/${study.slug}`} ogImage={`https://i.ytimg.com/vi/${study.youtubeId}/hqdefault.jpg`}>
  <article class="study-detail container"><header><a class="study-back" href="/estudos">← Todos os estudos</a><p class="eyebrow">Estudo bíblico</p><h1>{study.title}</h1><p class="study-date"><time datetime={study.publishedAt}>{formatStudyDate(study.publishedAt)}</time></p><p class="study-summary">{study.summary}</p></header><div class="study-video"><iframe src={`https://www.youtube-nocookie.com/embed/${study.youtubeId}`} title={`Vídeo: ${study.title}`} allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><div class="study-content-grid"><section aria-labelledby="transcript-title"><h2 id="transcript-title" class="sr-only">Transcrição do estudo</h2><StudyTranscript source={study.transcript} /></section><aside class="study-references" aria-labelledby="references-title"><p class="eyebrow">Leia na Bíblia</p><h2 id="references-title">Referências relacionadas</h2><div>{study.references.map(reference=>{const book=bibleBooks[reference.book];const label=bibleReferenceLabel(reference);return <button type="button" data-bible-reference data-book={book.slug} data-code={book.code} data-chapter={reference.chapter} data-start={reference.verseStart} data-end={reference.verseEnd||reference.verseStart} data-label={label}>{label}<span aria-hidden="true">＋</span></button>})}</div></aside></div></article><BibleReferencePreview />
</BaseLayout>
