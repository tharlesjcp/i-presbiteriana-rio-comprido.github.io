---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudyCard from '../../components/StudyCard.astro';
import { studyRepository } from '../../repositories/StaticStudyRepository';
import '../../styles/studies.css';
const studies=await studyRepository.listPublished();const [latest,...previous]=studies;
---
<BaseLayout title="Estudos Bíblicos — IPRC" description="Estudos bíblicos da Igreja Presbiteriana do Rio Comprido." canonicalPath="/estudos">
  <section class="studies-hero"><div class="container"><p class="eyebrow">Palavra para a vida</p><h1>Estudos<br />Bíblicos</h1><p>Vídeos e textos para aprofundar a fé, acompanhar no seu ritmo e voltar às Escrituras.</p></div></section>
  {latest ? <>
    <section class="study-feature container" aria-labelledby="latest-study"><div class="study-video"><iframe src={`https://www.youtube-nocookie.com/embed/${latest.youtubeId}`} title={`Vídeo: ${latest.title}`} loading="eager" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><div><p class="eyebrow">Estudo mais recente</p><h2 id="latest-study">{latest.title}</h2><p>{latest.summary}</p><a class="button button-primary" href={`/estudos/${latest.slug}`}>Abrir estudo completo</a></div></section>
    {previous.length>0&&<section class="study-archive container" aria-labelledby="previous-studies"><div class="section-heading"><div><p class="eyebrow">Continue estudando</p><h2 id="previous-studies">Estudos anteriores</h2></div></div><div class="study-grid">{previous.map(study=><StudyCard {study} />)}</div></section>}
  </> : <section class="studies-empty container" data-empty-studies><span aria-hidden="true">✦</span><p class="eyebrow">Em preparação</p><h2>Os estudos bíblicos serão publicados aqui em breve.</h2><p>Enquanto isso, você pode acompanhar a agenda da igreja ou continuar sua leitura na Bíblia IPRC.</p><div class="button-row"><a class="button button-primary" href="/#agenda">Ver agenda</a><a class="button studies-outline" href="/biblia/joao/11">Abrir a Bíblia</a></div></section>}
</BaseLayout>
