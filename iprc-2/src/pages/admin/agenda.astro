---
import AdminLayout from '../../layouts/AdminLayout.astro';
import '../../styles/admin-agenda.css';
---
<AdminLayout title="Agenda" description="Administração da programação e dos eventos da IPRC" current="agenda">
  <header class="admin-page-header admin-page-header--compact"><p class="admin-eyebrow">Agenda</p><h1>Programação<br />e eventos.</h1><p>Atualize os encontros semanais e publique eventos especiais. As alterações públicas aparecem na agenda da igreja.</p><p id="session" class="admin-session" aria-live="polite">Confirmando acesso…</p></header>
  <div id="feedback" class="admin-feedback" role="status" aria-live="polite" hidden></div>
  <section class="admin-section" aria-labelledby="weekly-title"><div class="admin-section-heading"><div><p class="admin-eyebrow">Toda semana</p><h2 id="weekly-title">Programação semanal</h2></div><button class="admin-button admin-button--secondary" type="button" id="new-recurring">Nova programação</button></div><div id="recurring-list" class="admin-editor-list" aria-busy="true"><p>Carregando programação…</p></div></section>
  <section class="admin-section" aria-labelledby="events-title"><div class="admin-section-heading"><div><p class="admin-eyebrow">Datas especiais</p><h2 id="events-title">Eventos especiais</h2></div><button class="admin-button" type="button" id="new-event">Novo evento</button></div><div id="events-list" class="admin-editor-list" aria-busy="true"><p>Carregando eventos…</p></div></section>
  <dialog id="editor-dialog" class="admin-dialog" aria-labelledby="dialog-title"><form id="editor-form" method="dialog"><div class="admin-dialog-heading"><div><p class="admin-eyebrow" id="dialog-kind">Agenda</p><h2 id="dialog-title">Editar</h2></div><button type="button" class="admin-icon-button" id="close-dialog" aria-label="Fechar">×</button></div><input type="hidden" name="entityType" /><input type="hidden" name="id" /><input type="hidden" name="expectedUpdatedAt" /><div class="admin-form-grid">
    <label class="admin-field admin-field--wide">Título <input name="title" required maxlength="120" /></label>
    <div id="recurring-fields" class="admin-form-contents"><label class="admin-field">Dia da semana <select name="weekday"><option value="0">Domingo</option><option value="1">Segunda-feira</option><option value="2">Terça-feira</option><option value="3">Quarta-feira</option><option value="4">Quinta-feira</option><option value="5">Sexta-feira</option><option value="6">Sábado</option></select></label><label class="admin-field">Ordem <input name="sortOrder" type="number" min="0" max="999" value="0" /></label></div>
    <div id="event-fields" class="admin-form-contents"><label class="admin-field">Data <input name="startDate" type="date" /></label><label class="admin-field">Data final <span>(opcional)</span><input name="endDate" type="date" /></label><label class="admin-field admin-field--wide">Situação <select name="status"><option value="draft">Rascunho</option><option value="published">Publicado</option><option value="cancelled">Cancelado</option></select></label></div>
    <label class="admin-field">Horário inicial <input name="startTime" type="time" /></label><label class="admin-field">Horário final <span>(opcional)</span><input name="endTime" type="time" /></label><label class="admin-field admin-field--wide">Local <input name="locationName" required maxlength="160" /></label><label class="admin-field admin-field--wide">Endereço <span>(opcional)</span><input name="locationAddress" maxlength="240" /></label><label class="admin-field admin-field--wide event-only">Resumo <span>(opcional)</span><textarea name="summary" rows="2" maxlength="320"></textarea></label><label class="admin-field admin-field--wide">Descrição <span>(opcional)</span><textarea name="description" rows="4" maxlength="4000"></textarea></label><label class="admin-switch recurring-only"><input name="active" type="checkbox" /> Programação ativa</label>
  </div><div class="admin-dialog-actions"><button type="button" class="admin-button admin-button--ghost" id="cancel-dialog">Cancelar</button><button type="submit" class="admin-button" id="save-button">Salvar</button></div></form></dialog>
  <template id="item-template"><article class="admin-editor-card"><div><p class="admin-card-meta"></p><h3></h3><p class="admin-card-detail"></p></div><div class="admin-card-actions"><span class="admin-pill"></span><button type="button" class="admin-button admin-button--secondary">Editar</button></div></article></template>
</AdminLayout>

<script>
type Entity=Record<string,any>;const recurring=new Map<string,Entity>(),events=new Map<string,Entity>();const query=<T extends HTMLElement>(s:string)=>document.querySelector<T>(s)!;const feedback=query<HTMLDivElement>('#feedback'),dialog=query<HTMLDialogElement>('#editor-dialog'),form=query<HTMLFormElement>('#editor-form');const show=(m:string,e=false)=>{feedback.hidden=false;feedback.textContent=m;feedback.dataset.kind=e?'error':'success'};const api=async(p:string,o:RequestInit={})=>{const r=await fetch(p,{...o,headers:{'content-type':'application/json',...(o.headers||{})}}),b=await r.json() as Entity;if(!r.ok)throw new Error(b.error?.message||'Não foi possível concluir a operação.');return b.data};const datePt=(v:string)=>new Intl.DateTimeFormat('pt-BR',{timeZone:'UTC'}).format(new Date(`${v}T00:00:00Z`));
const render=(target:string,items:Entity[],kind:'recurring'|'event')=>{const list=query<HTMLDivElement>(target);list.replaceChildren();list.ariaBusy='false';if(!items.length){const p=document.createElement('p');p.className='admin-empty';p.textContent=kind==='event'?'Nenhum evento especial cadastrado.':'Nenhuma programação cadastrada.';list.appendChild(p);return}for(const item of items){const node=query<HTMLTemplateElement>('#item-template').content.cloneNode(true) as DocumentFragment;node.querySelector('h3')!.textContent=item.title;node.querySelector('.admin-card-meta')!.textContent=kind==='recurring'?['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'][item.weekday]:datePt(item.startDate);node.querySelector('.admin-card-detail')!.textContent=`${item.startTime||'Sem horário'} · ${item.location.name}`;const pill=node.querySelector('.admin-pill')!;const labels:Record<string,string>={draft:'Rascunho',published:'Publicado',cancelled:'Cancelado'};pill.textContent=kind==='recurring'?(item.active?'Ativa':'Inativa'):labels[item.status]||item.status;(node.querySelector('button') as HTMLButtonElement).addEventListener('click',()=>openEditor(kind,item));list.appendChild(node)}};
const load=async()=>{try{const [session,schedules,specials]=await Promise.all([api('/api/admin/session'),api('/api/admin/agenda/recurring'),api('/api/admin/agenda/events')]);query('#session').textContent=`Acesso confirmado para ${session.email}`;recurring.clear();schedules.forEach((x:Entity)=>recurring.set(x.id,x));events.clear();specials.forEach((x:Entity)=>events.set(x.id,x));render('#recurring-list',schedules,'recurring');render('#events-list',specials,'event')}catch(error){show(error instanceof Error?error.message:'Falha ao carregar.',true);query('#session').textContent='Acesso não confirmado'}};const set=(n:string,v:any)=>{const f=form.elements.namedItem(n) as HTMLInputElement;if(f.type==='checkbox')f.checked=Boolean(v);else f.value=v??''};
const openEditor=(kind:'recurring'|'event',item:Entity={})=>{form.reset();set('entityType',kind);set('id',item.id);set('expectedUpdatedAt',item.updatedAt);set('title',item.title);set('startTime',item.startTime);set('endTime',item.endTime);set('locationName',item.location?.name||'Igreja Presbiteriana do Rio Comprido');set('locationAddress',item.location?.address||'Rua Sampaio Viana, 185, Rio Comprido - RJ');set('description',item.description);set('weekday',item.weekday??0);set('sortOrder',item.sortOrder??0);set('active',item.id?item.active:true);set('startDate',item.startDate);set('endDate',item.endDate);set('status',item.status||'draft');set('summary',item.summary);document.body.dataset.editor=kind;query('#dialog-kind').textContent=kind==='recurring'?'Programação semanal':'Evento especial';query('#dialog-title').textContent=item.id?'Editar registro':kind==='recurring'?'Nova programação':'Novo evento';dialog.showModal()};const value=(n:string)=>(form.elements.namedItem(n) as HTMLInputElement).value;
form.addEventListener('submit',async event=>{event.preventDefault();const kind=value('entityType'),id=value('id'),common={title:value('title'),startTime:value('startTime'),endTime:value('endTime'),location:{name:value('locationName'),address:value('locationAddress')},description:value('description')};const payload:Entity=kind==='recurring'?{...common,weekday:Number(value('weekday')),sortOrder:Number(value('sortOrder')),active:(form.elements.namedItem('active') as HTMLInputElement).checked}:{...common,startDate:value('startDate'),endDate:value('endDate'),summary:value('summary'),status:value('status')};if(id)payload.expectedUpdatedAt=value('expectedUpdatedAt');const base=kind==='recurring'?'/api/admin/agenda/recurring':'/api/admin/agenda/events',save=query<HTMLButtonElement>('#save-button');save.disabled=true;save.textContent='Salvando…';try{await api(id?`${base}/${encodeURIComponent(id)}`:base,{method:id?'PUT':'POST',body:JSON.stringify(payload)});dialog.close();show('Alteração salva com sucesso.');await load()}catch(error){show(error instanceof Error?error.message:'Falha ao salvar.',true)}finally{save.disabled=false;save.textContent='Salvar'}});query('#new-recurring').addEventListener('click',()=>openEditor('recurring'));query('#new-event').addEventListener('click',()=>openEditor('event'));query('#close-dialog').addEventListener('click',()=>dialog.close());query('#cancel-dialog').addEventListener('click',()=>dialog.close());load();
</script>
