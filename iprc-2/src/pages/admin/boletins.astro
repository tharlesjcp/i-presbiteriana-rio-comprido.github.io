---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminEditorCollection from '../../components/AdminEditorCollection.astro';
import bulletinStyles from '../../styles/admin-bulletins.css?raw';
import clientSource from '../../scripts/admin-bulletins.ts?raw';
import { iprcBulletinTemplate as template } from '../../data/bulletin-template';
import ts from 'typescript';
const clientCode=ts.transpileModule(clientSource,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ES2022}}).outputText;
---
<AdminLayout title="Boletins" description="Editor dos Boletins da IPRC" current="boletins">
  <style is:inline set:html={bulletinStyles}></style>
  <div id="bulletin-list-view">
    <header class="admin-page-header bulletin-admin-heading"><div><p class="admin-eyebrow">Boletins</p><h1>Edições<br />da comunidade.</h1><p>Crie, revise e publique o boletim semanal com segurança.</p></div><button class="admin-primary" type="button" id="new-bulletin">Novo boletim</button></header>
    <p id="bulletin-session" class="admin-session" aria-live="polite">Confirmando acesso…</p>
    <div id="bulletin-feedback" class="admin-feedback" role="status" hidden></div>
    <nav class="bulletin-filters" aria-label="Filtrar boletins"><button type="button" data-filter="all" aria-pressed="true">Todos</button><button type="button" data-filter="draft">Rascunhos</button><button type="button" data-filter="published">Publicados</button><button type="button" data-filter="trashed">Lixeira</button></nav>
    <section aria-labelledby="bulletin-list-title"><h2 class="sr-only" id="bulletin-list-title">Boletins cadastrados</h2><div id="bulletin-list" class="bulletin-admin-list"><p>Carregando boletins…</p></div></section>
  </div>

  <div id="bulletin-editor-view" hidden>
    <header class="bulletin-editor-header"><div><button class="admin-link-button" type="button" id="back-to-bulletins">← Voltar aos boletins</button><p class="admin-eyebrow">Editor de boletim</p><h1 id="editor-heading">Novo boletim</h1><p id="publication-state" class="publication-state" aria-live="polite">Rascunho ainda não publicado</p></div><div class="save-cluster"><span id="save-status" role="status">Ainda não salvo</span><button class="admin-secondary" type="button" id="preview-button">Visualizar</button><button class="admin-secondary" type="button" id="unpublish-button" hidden>Despublicar</button><button class="admin-primary" type="button" id="publish-button">Publicar</button><button class="admin-primary" type="button" id="save-button">Salvar</button></div></header>
    <div id="editor-feedback" class="admin-feedback" role="alert" hidden></div>
    <form id="bulletin-form">
      <section class="bulletin-editor-section"><h2>Informações</h2><div class="bulletin-form-grid"><label>Número<input id="bulletin-number" type="number" min="1" required /></label><label>Data<input id="bulletin-date" type="date" required /></label><label>Template<select id="bulletin-template"><option value="iprc-padrao">IPRC padrão</option></select></label><label>Status editorial<select id="bulletin-status" disabled><option value="draft">Rascunho</option><option value="published">Publicado</option><option value="trashed">Lixeira</option></select></label></div><p class="field-help">Publicar, republicar e despublicar exigem uma ação explícita. O autosave nunca altera sozinho a versão pública.</p></section>
      <section class="bulletin-editor-section"><div class="section-title"><div><h2>Pastoral</h2><p>O título pode ficar vazio enquanto o boletim for rascunho.</p></div></div><label>Título<input id="pastoral-title" maxlength="180" /></label><label>Referência bíblica opcional<input id="pastoral-reference" placeholder="Ex.: João 3:16" /></label><div class="rich-editor"><div class="rich-toolbar" role="toolbar" aria-label="Formatação do texto pastoral"><button type="button" data-command="undo" aria-label="Desfazer">↶</button><button type="button" data-command="redo" aria-label="Refazer">↷</button><button type="button" data-command="bold"><strong>Negrito</strong></button><button type="button" data-command="italic"><em>Itálico</em></button><button type="button" data-block="h3">Subtítulo</button><button type="button" data-command="insertUnorderedList">Lista</button><button type="button" data-block="blockquote">Citação</button><button type="button" data-block="p">Parágrafo</button></div><div id="pastoral-body" class="rich-surface" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Escreva ou cole aqui o texto pastoral…"></div></div><p class="field-help">A colagem de Word ou Google Docs entra como texto limpo. HTML externo não é armazenado.</p></section>
      <AdminEditorCollection id="announcements" title="Avisos" description="Avisos reordenáveis. Imagens ficam para uma próxima entrega e não bloqueiam o boletim." button="Adicionar aviso" />
      <AdminEditorCollection id="activities" title="Atividades" description="Mantenha apenas no boletim, vincule à Agenda ou crie um novo evento público." button="Adicionar atividade" />
      <AdminEditorCollection id="birthdays" title="Aniversariantes" description="Cadastro manual. O padrão é somente impressão; escolha explicitamente se também deve aparecer no digital." button="Adicionar aniversariante" />
      <AdminEditorCollection id="diaconal" title="Escala diaconal" description="Informe a data e os responsáveis." button="Adicionar escala" />
      <AdminEditorCollection id="readings" title="Leituras bíblicas" description="Dia da semana e referência para leitura." button="Adicionar leitura" />
    </form>
  </div>

  <dialog id="bulletin-preview" class="bulletin-preview-dialog"><div class="preview-dialog-header"><div><p class="admin-eyebrow">Prévia do boletim</p><h2>Visualização</h2></div><button type="button" id="close-preview" aria-label="Fechar prévia">×</button></div><div class="preview-tabs" role="tablist"><button type="button" role="tab" aria-selected="true" data-preview-tab="digital">Digital</button><button type="button" role="tab" aria-selected="false" data-preview-tab="print">Impressão</button></div><div id="digital-preview" class="bulletin-live-digital"></div><div id="print-preview" class="bulletin-live-print" hidden><p id="fit-indicator" class="fit-indicator"></p><div class="live-sheet"><article class="live-back"><small>Painel 1 · contracapa</small><img src="/logo-iprc.svg" alt="" /><h3>Agenda semanal</h3><ul>{template.weeklySchedule.map(item => <li>{item}</li>)}</ul><h3>Contato</h3><p>{template.email}<br />{template.social.join(' · ')}</p><h3>Liderança</h3>{template.leadership.map(item => <p>{item}</p>)}<footer>{template.address}<br />{template.institutional}</footer></article><article><small>Painel 2 · conteúdo mensal</small><div data-print-info></div><div class="contribution"><h3>Contribuição</h3>{template.contribution.map(item => <p>{item}</p>)}</div></article><article class="live-cover"><small>Painel 3 · capa</small><img src="/logo-iprc.svg" alt="" /><div class="annual-title"><strong>{template.title}</strong><span>{template.subtitle}</span></div><div data-print-cover></div></article></div><div class="live-sheet live-inside"><article><small>Painel 4</small><h3>Pastoral</h3><div data-print-pastoral></div></article><article><small>Painel 5</small><h3>Pastoral · continuação</h3><div data-print-pastoral-cont></div></article><article><small>Painel 6</small><div data-print-announcements></div></article></div></div></dialog>
</AdminLayout>
<script is:inline type="module" set:html={clientCode}></script>
