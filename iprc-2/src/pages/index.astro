---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StudyCard from '../components/StudyCard.astro';
import BulletinCard from '../components/BulletinCard.astro';
import QuickAccessCard from '../components/QuickAccessCard.astro';
import CalendarSection from '../components/CalendarSection.astro';
import { LEGACY_BASE, bulletin } from '../data/site';
import { studyRepository } from '../repositories/StaticStudyRepository';
const studies=await studyRepository.listPublished();
---
<BaseLayout title="IPRC — Igreja Presbiteriana do Rio Comprido" description="Uma comunidade cristã reformada, acolhedora e presente no coração do Rio de Janeiro.">
  <Hero />
  <section class="section intro" id="quem-somos" aria-labelledby="intro-title"><div class="container intro-grid"><div><p class="eyebrow">Uma igreja para a cidade</p><h2 id="intro-title">Palavra, comunhão<br />e serviço.</h2></div><div><p class="intro-lead">Há décadas no Rio Comprido, somos uma comunidade de pessoas diferentes reunidas pela mesma graça.</p><p>Queremos viver uma fé bíblica, simples e relevante — acolhendo famílias, cuidando uns dos outros e servindo ao bairro.</p><a class="text-link" href={`${LEGACY_BASE}/sobre.html`}>Planeje sua visita <span aria-hidden="true">→</span></a></div><div class="values" aria-label="Nossos valores"><span><strong>01</strong>Palavra</span><span><strong>02</strong>Comunhão</span><span><strong>03</strong>Missão</span></div></div></section>
  <CalendarSection />
  <section class="section studies" id="estudos" aria-labelledby="studies-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">Aprenda e aprofunde</p><h2 id="studies-title">Estudos recentes</h2></div><p>Conteúdo bíblico para acompanhar no seu ritmo, durante toda a semana.</p></div>{studies.length?<div class="study-grid">{studies.slice(0,3).map(study => <StudyCard {study} />)}</div>:<div class="home-studies-empty"><p>Os estudos bíblicos serão publicados aqui em breve.</p></div>}<p class="home-studies-action"><a class="text-link" href="/estudos">Ver todos os estudos <span aria-hidden="true">→</span></a></p></div></section>
  <section class="section bulletin-section" id="boletim"><div class="container"><BulletinCard {...bulletin} /></div></section>
  <section class="section quick-section" aria-labelledby="quick-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">Sempre à mão</p><h2 id="quick-title">Acessos rápidos</h2></div></div><div class="quick-grid"><QuickAccessCard title="Bíblia" description="Leia e estude as Escrituras" icon="✦" href="/biblia/joao/11" /><QuickAccessCard title="Hinário" description="Pesquise o Novo Cântico" icon="♫" href="/hinario" /><QuickAccessCard title="Pedido de oração" description="Compartilhe com cuidado e privacidade" icon="♡" href={`${LEGACY_BASE}/pedidos.html`} /></div></div></section>
  <section class="visit-section"><div class="container visit-grid"><div><p class="eyebrow">Sua primeira visita</p><h2>Existe um lugar<br />para você aqui.</h2></div><div><p>Chegue alguns minutos antes, venha como se sentir confortável e procure nossa equipe de acolhimento. Será uma alegria receber você.</p><div class="button-row"><a class="button button-primary" href={`${LEGACY_BASE}/sobre.html`}>Ver localização</a><a class="button button-ghost" href="#agenda">Ver programação</a></div></div></div></section>
</BaseLayout>
