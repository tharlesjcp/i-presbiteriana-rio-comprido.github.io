---
import { readFile } from 'node:fs/promises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/bible.css';
const manifest = JSON.parse(await readFile(new URL('../../../public/bible-data/manifest.json', import.meta.url),'utf8'));
export async function getStaticPaths(){ const { readFile } = await import('node:fs/promises'); const data=JSON.parse(await readFile(new URL('../../../public/bible-data/manifest.json',import.meta.url),'utf8')); return [{params:{path:undefined}},{params:{path:'fontes-e-licencas'},props:{sources:true}},...data.books.flatMap((book:any)=>Array.from({length:book.chapters},(_,i)=>({params:{path:`${book.slug}/${i+1}`}})))]; }
const sources = Astro.props.sources || Astro.params.path === 'fontes-e-licencas';
---
<BaseLayout title={sources ? 'Fontes e licenças — Bíblia IPRC' : 'Bíblia 2.0 — IPRC'} description="Leia, compare versões e estude o texto bíblico em português, grego e hebraico.">
  <div class="bible-shell" data-reader={!sources || undefined}>
    {sources ? <section class="sources-page container">
      <p class="eyebrow">Transparência editorial</p><h1>Fontes e licenças</h1>
      <p class="sources-lead">Cada texto e ferramenta informa origem, licença e estado de verificação. Traduções bloqueadas não são publicadas.</p>
      <div class="source-list">{manifest.versions.map((v:any)=><article class="source-card"><div><h2>{v.name}</h2><span class:list={['status',v.status]}>{v.status}</span></div><dl><dt>Fonte</dt><dd>{v.source}</dd><dt>Licença</dt><dd>{v.license}</dd><dt>Atribuição</dt><dd>{v.attribution || 'Não disponível'}</dd></dl>{v.warning && <p class="source-warning">{v.warning}</p>}</article>)}</div>
      <article class="source-card"><h2>Dados de estudo</h2><p>Grego: Textus Receptus Parsed NT, domínio público. Hebraico: WLC vocalizado, domínio público; a camada completa OSHB/STEPBible de lemma e morfologia permanece identificada como não disponível onde ainda não foi importada. Referências: OpenBible.info Cross References, CC Attribution, sem reprodução do texto ESV.</p></article>
      <p class="source-actions"><a class="button button-primary" href="/biblia/joao/11">Voltar à leitura</a> <a href="/bible-data/integrity-report.json">Relatório de integridade (JSON)</a></p>
    </section> : <>
      <section class="reader-toolbar" aria-label="Controles de leitura"><div class="container toolbar-inner">
        <div class="reader-title"><p>Bíblia IPRC</p><h1 data-reference>Carregando leitura…</h1></div>
        <div class="reader-controls"><label><span>Livro</span><select data-book></select></label><label><span>Capítulo</span><select data-chapter></select></label><label><span>Versão</span><select data-version></select></label><button type="button" data-parallel aria-pressed="false">Paralelo</button><button type="button" data-font aria-label="Alterar tamanho do texto">Aa</button></div>
      </div></section>
      <aside class="legacy-notice container" data-legacy hidden role="status"><div><strong>ARA · legado/não verificada</strong><p data-warning></p><a href="/biblia/fontes-e-licencas">Saiba mais</a></div><button type="button" data-dismiss>Entendi</button></aside>
      <section class="reader-area container" aria-live="polite" aria-busy="true" data-swipe>
        <button class="chapter-arrow previous" type="button" data-previous aria-label="Capítulo anterior">←</button><div class="reading-columns" data-content><p class="loading">Preparando o capítulo…</p></div><button class="chapter-arrow next" type="button" data-next aria-label="Próximo capítulo">→</button>
      </section>
      <nav class="mobile-chapter-nav" aria-label="Navegação entre capítulos"><button type="button" data-previous>← <span>Anterior</span></button><strong data-mobile-reference>—</strong><button type="button" data-next><span>Próximo</span> →</button></nav>
      <dialog class="verse-dialog" data-dialog><form method="dialog"><button class="dialog-close" aria-label="Fechar">×</button></form><div data-dialog-content></div></dialog>
    </>}
  </div>
  {!sources && <script is:inline src="/scripts/bible-reader.js"></script>}
</BaseLayout>
