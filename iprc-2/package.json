{
  "name": "iprc-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "astro dev",
    "bible:build": "node scripts/build-bible-data.mjs",
    "bible:audit": "node scripts/build-bible-data.mjs --audit-only",
    "bible:test": "node scripts/test-bible-data.mjs",
    "hymnal:build": "node scripts/import-hymnal-data.mjs",
    "hymnal:test": "node scripts/test-hymnal-data.mjs",
    "study:test": "node --experimental-strip-types scripts/test-study-data.mjs",
    "agenda:test": "node --experimental-strip-types scripts/test-agenda-data.mjs",
    "predev": "pnpm bible:build && pnpm hymnal:build",
    "prebuild": "pnpm bible:build && pnpm hymnal:build",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "pnpm bible:audit && pnpm bible:build && pnpm bible:test && pnpm hymnal:build && pnpm hymnal:test && pnpm study:test && pnpm agenda:test && pnpm check && pnpm build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.5",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
