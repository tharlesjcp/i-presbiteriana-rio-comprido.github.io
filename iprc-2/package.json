{
  "name": "iprc-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "astro dev",
    "bible:build": "node scripts/build-bible-data.mjs",
    "bible:audit": "node scripts/build-bible-data.mjs --audit-only",
    "predev": "pnpm bible:build",
    "prebuild": "pnpm bible:build",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "pnpm bible:audit && pnpm check && pnpm build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.5",
    "typescript": "^5.9.2"
  }
